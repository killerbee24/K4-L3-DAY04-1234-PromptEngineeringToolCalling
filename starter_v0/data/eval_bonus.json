      "expect": {
        "tool_calls": [
          {
            "name": "lookup_ticket_status",
            "args": {"ticket_id": "LAB-1002"}
          }
        ]
      },
      "metadata": {
        "skill": "ticket_lookup",
        "difficulty": "easy",
